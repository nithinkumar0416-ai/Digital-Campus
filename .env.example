# ============================================================
# EduFAZE AI — Environment Variables
# ============================================================
# Google Gemini API Key (Required for live ChatGPT-style assistant)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify supported Gemini model (defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash-latest, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
